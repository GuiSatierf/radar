# Copied to .env by `npm run setup`. Every value here is for local development only.

# Product name shown in the interface (the client decides the final one).
APP_NAME="Prisciane"

# Local Postgres from docker-compose.yml. Tests use the *_test database, never this one.
DATABASE_URL="postgres://prisciane:prisciane_local_only@127.0.0.1:55434/prisciane_dev"
TEST_DATABASE_URL="postgres://prisciane:prisciane_local_only@127.0.0.1:55434/prisciane_test"

# Better Auth. `npm run setup` replaces the secret with a random one when it creates .env.
BETTER_AUTH_SECRET="replace-me-with-at-least-32-random-characters"
BETTER_AUTH_URL="http://localhost:3210"

# Header with the real client IP, used by the login rate limit. It must be one the reverse proxy
# overwrites (Traefik sets x-real-ip); never x-forwarded-for, which the client can forge.
CLIENT_IP_HEADER="x-real-ip"

# Demo account created by `npm run db:seed` (local and demo environment only).
SEED_DEMO_EMAIL="demo@prisciane.test"
SEED_DEMO_PASSWORD="demo-local-12345"

# E-mail of the account that becomes admin (the admin area, plans and blocking). The account must
# already exist: sign up first, then set this and restart (the container grants it at startup;
# locally, `npm run db:seed`). Keep it blank here: `npm run setup` fills in the demo account only
# in the local .env, so no other environment inherits the public demo e-mail as admin.
ADMIN_EMAIL=""

# Where "Falar com o suporte" leads, for people asking to unlock a plan (https, e.g. a WhatsApp
# link). Optional: without it the locked screens only say to contact support.
SUPPORT_URL=""

# Secret for the daily product collection (POST /api/cron/collect-products with
# "Authorization: Bearer <CRON_SECRET>"). Leave empty locally: the route stays off.
CRON_SECRET=""

# Shopee affiliate Open API key (from the affiliate account, after Shopee approves API access).
# With it, `npm run collect` and the daily collection bring the real catalog (about 2,800
# products, under a minute); without it the app keeps the fictitious catalog. Set both or neither.
SHOPEE_AFFILIATE_APP_ID=""
SHOPEE_AFFILIATE_SECRET=""

# Development and tests only: e-mails (like "esqueci minha senha") are written to
# <folder>/emails.jsonl instead of being sent. Leave empty in demo and production: until a real
# e-mail provider exists, the app points people to support instead.
EMAIL_OUTBOX_DIR=".outbox"

# Real e-mail through Resend (demo and production). Both or neither: the key starts with re_, and
# EMAIL_FROM is an address on a domain verified in Resend, like "Prisciane <nao-responda@dominio>".
# EMAIL_OUTBOX_DIR wins when both are set, so development and tests never send real e-mail.
RESEND_API_KEY=""
EMAIL_FROM=""

# trace | debug | info | warn | error
LOG_LEVEL="info"
